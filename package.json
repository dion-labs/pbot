{
  "name": "pocket-bot",
  "version": "0.1.2",
  "private": true,
  "description": "Experimental local Android automation workbench with durable progress and guarded, owned-only actions",
  "author": "Dion Labs",
  "license": "MIT",
  "homepage": "https://github.com/dion-labs/pbot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dion-labs/pbot.git"
  },
  "bugs": {
    "url": "https://github.com/dion-labs/pbot/issues"
  },
  "keywords": [
    "android",
    "automation",
    "local-first",
    "computer-vision",
    "adb",
    "experimental"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:dashboard": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --port 3001",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs && uv run pytest",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.57.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.136.1"
  },
  "type": "module"
}
